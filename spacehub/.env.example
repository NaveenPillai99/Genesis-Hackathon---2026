# Copy this file to .env.local and fill in your Supabase project details
# (Project Settings -> API in the Supabase dashboard).
#
# If these are left unset, SpaceHub automatically runs in "mock mode":
# all data lives in the browser (localStorage) and double-booking is
# prevented in JavaScript instead of by the Postgres EXCLUDE constraint.
# Mock mode is great for a demo/pilot; switch to real Supabase before
# this is used by more than one person at a time, since mock data is
# NOT shared between browsers/devices.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
